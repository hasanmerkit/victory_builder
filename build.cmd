REM --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- #
REM [T] Load TeTeOS.Net Script Framework
	REM [F] Functions
		REM [i] Message Functions
			REM [V] Icons
				REM [T] TeTeOS.Net
                    set "_T_=[T]"
                REM [P] PiluX
                    set "_P_=[P]"
                REM [i] Message icons
                    set "_empty_=[ ]"
                    set "_info_=[i]"
                    set "_question_=[?]"
                    set "_success_=[+]"
                    set "_warning_=[^!]"
                    set "_loading_=[%%]"
                    set "_error_=[X]"
                REM [.] Task icons
                    set "_read_=[<]"
                    set "_write_=[>]"
                    set "_step_= - "
                    set "_debug_=[#]"
                    set "_temp_=[~]"
                REM [.] OS icons
                    set "_U_=[U]"
                    set "_D_=[D]"
                    set "_L_=[L]"
                    set "_A_=[A]"
                    set "_W_=[W]"
            REM [~] Temp
                goto Functions_Z
                :temp
                    if not "%~1" == "" ( echo !_temp_! %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
            REM [i] Info
                :info
                    if not "%~1" == "" ( echo !_info_! %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
            REM [?] Question
                :question
                    if not "%~1" == "" ( <nul set /p "=!_question_! %~1 " )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
            REM [√] Success
                :success
                    if not "%~1" == "" ( echo !_success_! %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
            REM [!] Warning
                :warning
                    if not "%~1" == "" ( echo !_warning_! %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
            REM [%] Loading
                :loading
                    if not "%~1" == "" ( echo !_loading_! %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
            REM [X] Error
                :error
                    if not "%~1" == "" ( echo !_error_! %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    if not "%~3" == "" ( echo     %~3 )
                    exit /b 0
                :error_os
                    echo !_error_! Unsupported Operating System.
                    if not "%~1" == "" ( echo     %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    exit /b 0
                :error_arch
                    echo !_error_! Unsupported Architecture.
                    if not "%~1" == "" ( echo     %~1 )
                    if not "%~2" == "" ( echo     %~2 )
                    exit /b 0
                :error_cd
                    if not "%~1" == "" ( echo !_error_! Failed to change working directory: '%~1' )
                    if "%~1" == "" ( echo !_error_! Failed to change working directory )
                    echo     The path may not exist or you do not have sufficient permissions.
                    exit /b 0
                :error_cp
                    if not "%~2" == "" ( echo !_error_! Failed to copy: '%~1' to '%~2' )
                    if "%~2" == "" ( echo !_error_! Failed to copy: '%~1' )
                    echo     The path may not exist or you do not have sufficient permissions.
                    exit /b 0
                :error_mv
                    if not "%~2" == "" ( echo !_error_! Failed to move: '%~1' to '%~2' )
                    if "%~2" == "" ( echo !_error_! Failed to move: '%~1' )
                    echo     The path may not exist or you do not have sufficient permissions.
                    exit /b 0
                :error_rm
                    if not "%~1" == "" ( echo !_error_! Failed to remove: '%~1' )
                    if "%~1" == "" ( echo !_error_! Failed to remove. )
                    echo     The path may not exist, locked by a program or you do not have sufficient permissions.
                    exit /b 0
                :error_rmdir
                    if not "%~1" == "" ( echo !_error_! Failed to remove directory: '%~1' )
                    if "%~1" == "" ( echo !_error_! Failed to remove directory. )
                    echo     The path may not exist, locked by a program or you do not have sufficient permissions.
                    exit /b 0
                :error_mkdir
                    if not "%~1" == "" ( echo !_error_! Failed to create directory: '%~1' )
                    if "%~1" == "" ( echo !_error_! Failed to create directory. )
                    echo     The path may not exist, locked by a program or you do not have sufficient permissions.
                    exit /b 0
        REM [$] Command Checker
            :command_exist
                for %%i in ("%~1.exe") do if not "%%~$PATH:i"=="" ( exit /b 0 )
                exit /b 1
        REM [F] Parameter Checkers
            REM Example usages:
            REM call :Bin_Params_Exist "--debug" && set "Debug=1" || set "Debug=0"
            REM call :Bin_Params_Parse "--test" & if defined Result ( echo !RESULT! )
            :Bin_Params_Exist
                set "RESULT="
                if "%~1" == "" ( exit /b 1 )
                for %%C in (!Bin_Params!) do ( set "Check=%%~C"
                    REM [=] Is it a key? (Starts with "-" or "--")
                        set "Check_FirstLetter=!Check:~0,1!"
                        if "!Check_FirstLetter!" == "-" (
                            if /i "%%~C" == "%~1" ( exit /b 0 )
                        )
                )
                exit /b 1
            :Bin_Params_Parse
                set "RESULT="
                set "Key_Found=0"
                if "%~1" == "" ( exit /b 1 )
                for %%C in (!Bin_Params!) do (
                    set "Check=%%~C"
                    REM [=] Check if this part starts with the key we look for
                        for /f "tokens=1* delims= " %%A in ("%%~C") do (
                            if /i "%%A" == "%~1" (
                                REM [1] Key and Value are in the same quotes "--test a"
                                if not "%%B" == "" (
                                    if defined RESULT (set "RESULT=!RESULT! %%B") else (set "RESULT=%%B")
                                    set "Key_Found=0"
                                ) else (
                                    REM [2] Only key found, look for value in next loop
                                    set "Key_Found=1"
                                )
                            ) else (
                            REM [=] Is this a new key starting with -?
                                set "CheckVal=%%~C"
                                if "!CheckVal:~0,1!" == "-" (
                                    set "Key_Found=0"
                                ) else (
                                    REM [.] If we were looking for a value, grab it
                                        if !Key_Found! == 1 (
                                            if defined RESULT (set "RESULT=!RESULT! %%~C") else (set "RESULT=%%~C")
                                        )
                                )
                        )
                    )
                )
                exit /b
            :Functions_Z
    REM [1] Check OS
        REM [$] Essential Commands
            call :command_exist "cmd" || ( call :error_os & exit /b 1 )
            call :command_exist "attrib" || ( call :error_os & exit /b 1 )
            call :command_exist "find" || ( call :error_os & exit /b 1 )
            call :command_exist "icacls" || ( call :error_os & exit /b 1 )
            call :command_exist "ping" || ( call :error_os & exit /b 1 )
            call :command_exist "reg" || ( call :error_os & exit /b 1 )
            call :command_exist "takeown" || (
                reg query "HKLM\Software\Wine" >nul 2>&1 || ( call :error_os & exit /b 1 )
            )
        REM [=] Check is WinPE?
            set "OS_Name=Windows" & set "OS_Layer=Native"
            call :command_exist "wpeutil" && set "OS_Name=WinPE"
        REM [~] $OS_Layer (OS in other OS)
            reg query "HKLM\Software\Wine" >nul 2>nul && ( set "OS_Layer=Wine" )
            if defined CONTAINER_SANDBOX_MOUNT_POINT (
                set "OS_Layer=Sandbox"
                if exist "%SystemDrive%\.dockerenv" set "OS_Layer=Docker"
            )
    REM [2] Check OS Version
        REM [$] Kernel
            set "OS_Kernel=Windows NT"
            if "!OS_Layer!" == "Wine" ( set "OS_Kernel=Wine Layer" )
            set "OS_Kernel_Ver="
            ver | find "[" >nul
            if !errorlevel! equ 0 (
                for /f "tokens=4-5 delims=. " %%i in ('ver') do ( set "OS_Kernel_Ver=%%i.%%j" )
            ) else (
                for /f "tokens=3-4 delims=. " %%i in ('ver') do ( set "OS_Kernel_Ver=%%i.%%j" )
            )
            set "OS_Ver_ID="
            for /f "tokens=2,*" %%A in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v "CurrentBuildNumber" 2^>nul ^| find "CurrentBuildNumber"') do set "OS_Ver_ID=%%B"
        REM [=] Kernel to !OS_Ver!
            set "OS_Ver="
            if "!OS_Kernel_Ver!" == "6.1" ( set "OS_Ver=7" )
            if "!OS_Kernel_Ver!" == "6.2" ( set "OS_Ver=8" )
            if "!OS_Kernel_Ver!" == "6.3" ( set "OS_Ver=8.1" )
            if "!OS_Kernel_Ver!" == "10.0" ( set "OS_Ver=10" )
            if "!OS_Ver!" == "10" ( if !OS_Ver_ID! GEQ 22000 set "OS_Ver=11" )
            if "!OS_Ver!" == "" ( call :error_os & exit /b 1 )
        REM [<] Get Windows Display Version (!OS_Ver_Code! = 2?H?)
            set "OS_Ver_Code="
            for /f "tokens=2,*" %%A in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v "DisplayVersion" 2^>nul ^| find "DisplayVersion"') do set "OS_Ver_Code=%%B"
        REM [<] Get Windows Product Name
            set "OS_Ver_ProductName="
            for /f "tokens=2,*" %%A in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v "ProductName" 2^>nul ^| find "ProductName"') do set "OS_Ver_ProductName=%%B"
        REM [$] CMD Color Support
            set "OS_Ver_CmdNew=0"
            if "!OS_Ver!" == "10" if !OS_Ver_ID! GEQ 17763 ( set "OS_Ver_CmdNew=1" )
            if "!OS_Ver!" == "11" ( set "OS_Ver_CmdNew=1" )
            if "!OS_Layer!" == "Wine" ( set "OS_Ver_CmdNew=0" )
            if "!OS_Ver_CmdNew!" == "1" (
                REM [T] TeTeOS.Net
                    set "_T_=[38;5;166m[T][0m"
                REM [P] PiluX
                    set "_P_=[38;5;165m[P][0m"
                REM [i] Message icons
                    set "_empty_=[36m[ ][0m"
                    set "_info_=[36m[i][0m"
                    set "_question_=[36m[?][0m"
                    set "_success_=[32m[+][0m"
                    set "_warning_=[33m[^!][0m"
                    set "_loading_=[33m[%%][0m"
                    set "_error_=[31m[X][0m"
                REM [.] Task icons
                    set "_read_=[33m[<][0m"
                    set "_write_=[33m[>][0m"
                    set "_step_= [33m-[0m "
                    set "_debug_=[90m[#][0m"
                    set "_temp_=[33m[~][0m"
                REM [.] OS icons
                    set "_U_=[38;5;166m[U][0m"
                    set "_D_=[38;5;161m[D][0m"
                    set "_L_=[37m[L][0m"
                    set "_A_=[38;5;82m[A][0m"
                    set "_W_=[38;5;39m[W][0m"
            )
        REM [?] Is Server?
            echo !OS_Ver_ProductName! | find /i "Server">nul 2>nul && ( set "OS_Server=1" ) || ( set "OS_Server=0" )
    REM [3] Check OS Architecture
        REM [.] %PROCESSOR_ARCHITECTURE%
            set "OS_Arch="
            if /i "%PROCESSOR_ARCHITECTURE%" == "AMD64" set "OS_Arch=x64"
            if /i "%PROCESSOR_ARCHITECTURE%" == "x86"   set "OS_Arch=x86"
            if /i "%PROCESSOR_ARCHITECTURE%" == "ARM64" set "OS_Arch=arm64"
        REM [.] WoW64 check: 32-bit CMD in 64-bit OS
            if /i "%PROCESSOR_ARCHITEW6432%" == "AMD64" set "OS_Arch=x64"
            if /i "%PROCESSOR_ARCHITEW6432%" == "ARM64" set "OS_Arch=arm64"
            if "!OS_Arch!" == "" ( call :error_arch & exit /b 1 )
    REM [4] Check admin permission
        REM [=] Check %USERNAME%
            if not defined USERNAME ( call :error_os & exit /b 1 )
            if "%USERNAME%"=="SYSTEM" set "User_IsAdmin=1"
            if "%USERNAME%"=="Administrator" set "User_IsAdmin=1"
            if "%USERNAME%"=="Default" set "User_IsAdmin=1"
        REM [$] Check execute "net session"
            if "!User_IsAdmin!"=="" ( call :command_exist "net" && (
                net session >nul 2>nul && ( set "User_IsAdmin=1" )
            ) )
        REM [=] User is in admin group?
            if "!User_IsAdmin!"=="" ( call :command_exist "whoami" && ( call :command_exist "findstr" && (
                whoami /groups | findstr /b BUILTIN\Administrators >nul 2>nul && ( set "User_IsAdmin=2" )
            ) ) )
        REM [X] If still not detected, user is not an admin.
            if "!User_IsAdmin!"=="" ( set "User_IsAdmin=0" )
    REM [5] Create path variables
        set "Bin_File=%~nx0"
        set "Bin_Dir=%~dp0"
        set "Bin_Path=%~f0"
        set "Bin_FirstCD=%CD%"
        set "Bin_Params=%*"
        if "%Bin_File:~-1%"=="\" ( set "Bin_File=%Bin_File:~0,-1%" )
        if "%Bin_Dir:~-1%"=="\" ( set "Bin_Dir=%Bin_Dir:~0,-1%" )
        if "%Bin_Path:~-1%"=="\" ( set "Bin_Path=%Bin_Path:~0,-1%" )
        if "%Bin_FirstCD:~-1%"=="\" ( set "Bin_FirstCD=%Bin_FirstCD:~0,-1%" )
REM --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- #

REM --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- --- #

REM [.] Run the embedded PowerShell orchestration without generating helper scripts.
set "VICTORY_BUILD_FILE=%~f0"
call :info "Preparing: Windows x64 toolchain"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$text=[IO.File]::ReadAllText($env:VICTORY_BUILD_FILE); & ([scriptblock]::Create(($text -split '(?m)^:VICTORY_POWERSHELL\r?$',2)[1]))"
set "BuildResult=%errorlevel%"
echo.
pause
exit /b %BuildResult%

:VICTORY_POWERSHELL
$ErrorActionPreference = 'Stop'
function Info([string]$message) { Write-Host ($env:_info_ + ' ' + $message) }
function Fail([string]$message) { $script:ExpectedFailure = $true; throw $message }
function Native([string]$exe, [string[]]$arguments) {
    $ErrorActionPreference = 'Continue'
    & $exe @arguments >> $log 2>&1
    $ErrorActionPreference = 'Stop'
    if ($LASTEXITCODE -ne 0) { throw "Command failed with exit code ${LASTEXITCODE}: $exe" }
}
function Usable([string]$exe, [string[]]$arguments) {
    if (!(Test-Path -LiteralPath $exe -PathType Leaf)) { return $false }
    try { & $exe @arguments *> $null; return $LASTEXITCODE -eq 0 } catch { return $false }
}
try {
    if (!$installOnly) {
        $root = Split-Path -Parent $env:VICTORY_BUILD_FILE
        $work = Join-Path $env:TEMP ('victory-build-' + [guid]::NewGuid().ToString('N'))
        New-Item -ItemType Directory $work | Out-Null
        $log = Join-Path $work 'build.log'
        $sourceRoot = Join-Path $root 'source'
        if (!(Test-Path -LiteralPath (Join-Path $sourceRoot 'Cargo.toml'))) {
            New-Item -ItemType Directory -Force $sourceRoot | Out-Null
            Fail 'Copy your selected Victory workspace into source/ so that source/Cargo.toml and source/Cargo.lock exist, then run build.cmd again.'
        }
        $pointerArchives = @(Get-ChildItem -LiteralPath "$root\compiler\windows" -Filter '*.7z' -File -ErrorAction SilentlyContinue | Where-Object {
            $_.Length -lt 1024 -and [IO.File]::ReadAllText($_.FullName).StartsWith('version https://git-lfs.github.com/spec/v1')
        })
        if ($pointerArchives.Count -gt 0) {
            Info 'Downloading: compiler archive contents through Git LFS'
            if (!(Get-Command git.exe -ErrorAction SilentlyContinue)) { Fail 'Install Git and Git LFS, clone the toolkit repository, then run build.cmd again.' }
            $gitDirectory = & git.exe -C $root rev-parse --absolute-git-dir 2>> $log
            if ($LASTEXITCODE -ne 0) { Fail 'Compiler archives contain placeholders. Clone the toolkit with Git and install Git LFS, or supply the complete compiler archives.' }
            $attributes = Join-Path $gitDirectory 'info\attributes'
            New-Item -ItemType Directory -Force (Split-Path $attributes -Parent) | Out-Null
            $rule = 'compiler/windows/*.7z filter=lfs diff=lfs merge=lfs -text'
            if (!(Test-Path -LiteralPath $attributes) -or !([IO.File]::ReadAllText($attributes).Contains($rule))) {
                [IO.File]::AppendAllText($attributes, "`n$rule`n", [Text.Encoding]::ASCII)
            }
            Native 'git.exe' @('-C',$root,'lfs','pull','origin')
            foreach ($archive in $pointerArchives) {
                if ((Get-Item -LiteralPath $archive.FullName).Length -lt 1024) { Fail ('Compiler archive download was incomplete: ' + $archive.Name) }
            }
        }
        $arch = [Environment]::GetEnvironmentVariable('PROCESSOR_ARCHITEW6432')
        if (!$arch) { $arch = $env:PROCESSOR_ARCHITECTURE }
        if ($arch -ne 'AMD64') { Fail 'This project requires an x64 Windows host and builds Windows x64 only.' }
        $seven = $null
        $candidate = Get-Command 7z.exe -ErrorAction SilentlyContinue
        $candidates = @()
        if ($candidate) { $candidates += $candidate.Source }
        $regPath = (Get-ItemProperty 'HKLM:\SOFTWARE\7-Zip' -ErrorAction SilentlyContinue).Path
        if ($regPath) { $candidates += Join-Path $regPath '7z.exe' }
        $sharedSeven = Join-Path $env:ProgramFiles 'TeTeOS.Net\bin\7z.exe'
        $bundledSeven = Join-Path $root 'compiler\windows\bin\x64\7z.exe'
        $candidates += @("$env:ProgramFiles\7-Zip\7z.exe", $sharedSeven, $bundledSeven)
        foreach ($candidate in $candidates) {
            if (Usable $candidate @('i')) { $seven = $candidate; break }
        }
        if (!$seven) { Fail 'Please install 7zip.' }
    }
    $tools = Join-Path $env:ProgramFiles 'TeTeOS.Net\toolchains'
    $rustName = 'rust-1.100.0-sdk-windows-x64'
    $msvcName = 'msvc-14.51.36231-sdk-10.0.28000.0-windows-x64-x86-x64'
    $sha = [Security.Cryptography.SHA256]::Create()
    try { $lockHash = ([BitConverter]::ToString($sha.ComputeHash([IO.File]::ReadAllBytes("$root\source\Cargo.lock")))).Replace('-','').Substring(0,16).ToLowerInvariant() } finally { $sha.Dispose() }
    $depsName = 'victory-deps-' + $lockHash
    $rust = Join-Path $tools $rustName
    $msvc = Join-Path $tools $msvcName
    $deps = Join-Path $tools $depsName
    $vc = "$msvc\VC\Tools\MSVC\14.51.36231"
    $sdk = "$msvc\WindowsKits\10"
    $sdkVersion = '10.0.28000.0'
    function ValidRust {
        return ((Usable "$rust\bin\rustc.exe" @('--version')) -and (Usable "$rust\bin\cargo.exe" @('--version')) -and (Test-Path "$rust\lib\rustlib\x86_64-pc-windows-msvc\lib\libstd-*.rlib"))
    }
    function ValidMsvc {
        foreach ($file in @("$vc\bin\Hostx64\x64\cl.exe", "$vc\bin\Hostx64\x64\link.exe", "$vc\include\vcruntime.h", "$vc\lib\x64\libcmt.lib", "$sdk\Include\$sdkVersion\um\Windows.h", "$sdk\Include\$sdkVersion\ucrt\stdio.h", "$sdk\Lib\$sdkVersion\um\x64\kernel32.lib", "$sdk\Lib\$sdkVersion\ucrt\x64\libucrt.lib")) {
            if (!(Test-Path -LiteralPath $file)) { return $false }
        }
        return $true
    }
    function ValidDeps { return ((Test-Path "$deps\vendor" -PathType Container) -and (Test-Path "$deps\licenses.md" -PathType Leaf)) }
    $missing = @()
    if (!(ValidRust)) { $missing += $rustName }
    if (!(ValidMsvc)) { $missing += $msvcName }
    if (!(ValidDeps)) { $missing += $depsName }
    foreach ($name in $missing) {
        $bundle = "$root\compiler\windows\$name.7z"
        if (!(Test-Path -LiteralPath $bundle)) {
            if ($name -eq $depsName) { Fail "Missing offline dependency bundle: $bundle. This source revision needs its matching Cargo dependency package." }
            Fail "Missing tool: $name. Restore bundle: $bundle"
        }
    }
    $needSeven = (Test-Path -LiteralPath $bundledSeven) -and !(Test-Path -LiteralPath $sharedSeven)
    if ($installOnly) {
        New-Item -ItemType Directory -Force $tools | Out-Null
        foreach ($name in $missing) { $destination = $tools; if ($name -eq $msvcName) { $destination = Join-Path $tools $name }; Native $seven @('x', '-y', "-o$destination", "$root\compiler\windows\$name.7z") }
        if ($needSeven) {
            $sharedBin = Split-Path -Parent $sharedSeven
            New-Item -ItemType Directory -Force $sharedBin | Out-Null
            foreach ($name in @('7z.exe','7z.dll','7z_license.txt')) { Copy-Item -LiteralPath (Join-Path (Split-Path $bundledSeven) $name) -Destination $sharedBin }
            [IO.File]::WriteAllText((Join-Path $sharedBin '7z_arch.txt'), 'x64')
            if (!(Usable $sharedSeven @('i'))) { Fail 'Shared 7-Zip installation verification failed.' }
            $machinePath = [Environment]::GetEnvironmentVariable('Path','Machine')
            if (@($machinePath.Split(';') | Where-Object { $_.TrimEnd('\') -ieq $sharedBin.TrimEnd('\') }).Count -eq 0) {
                [Environment]::SetEnvironmentVariable('Path', ($machinePath.TrimEnd(';') + ';' + $sharedBin), 'Machine')
            }
        }
        if (!(ValidRust) -or !(ValidMsvc) -or !(ValidDeps)) { Fail 'Installed toolchain verification failed.' }
        exit 0
    }
    if ($missing.Count -gt 0 -or $needSeven) {
        Info 'Installing: missing shared build tools'
        $prefix = '$installOnly=$true;'
        foreach ($key in @('root','work','log','seven','bundledSeven','sharedSeven')) {
            $value = (Get-Variable -Name $key -ValueOnly).Replace("'", "''")
            $prefix += '$' + $key + "='" + $value + "';"
        }
        $buildPath = $env:VICTORY_BUILD_FILE.Replace("'", "''")
        $child = $prefix + '$text=[IO.File]::ReadAllText(''' + $buildPath + '''); & ([scriptblock]::Create(($text -split ''(?m)^:VICTORY_POWERSHELL\r?$'',2)[1]))'
        $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($child))
        try { $process = Start-Process powershell.exe -Verb RunAs -WindowStyle Hidden -ArgumentList @('-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand',$encoded) -PassThru -Wait }
        catch { Fail 'Admin permission required for installing required tools to TeTeOS.Net Toolchains.' }
        if ($process.ExitCode -ne 0) { Fail 'Shared tool installation failed. Admin permission required for installing required tools to TeTeOS.Net Toolchains.' }
        if (!(ValidRust) -or !(ValidMsvc) -or !(ValidDeps)) { Fail 'Installed toolchain verification failed.' }
    }
    $env:PATH = "$rust\bin;$vc\bin\Hostx64\x64;$sdk\bin\$sdkVersion\x64;" + $env:PATH
    $env:INCLUDE = "$vc\include;$sdk\Include\$sdkVersion\ucrt;$sdk\Include\$sdkVersion\shared;$sdk\Include\$sdkVersion\um;$sdk\Include\$sdkVersion\winrt"
    $env:LIB = "$vc\lib\x64;$sdk\Lib\$sdkVersion\ucrt\x64;$sdk\Lib\$sdkVersion\um\x64"
    $env:RUSTC = "$rust\bin\rustc.exe"
    $env:RUSTDOC = "$rust\bin\rustdoc.exe"
    $env:CARGO_HOME = Join-Path $work 'cargo-home'
    $env:CARGO_TARGET_DIR = Join-Path $work 'target'
    $env:CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER = "$vc\bin\Hostx64\x64\link.exe"
    $env:CARGO_ENCODED_RUSTFLAGS = '-C' + [char]31 + 'target-feature=+crt-static'
    $env:RUSTFLAGS = $null
    $env:RUSTUP_TOOLCHAIN = $null
    Set-Location -LiteralPath "$root\source"
    $vendorPath = "$deps\vendor".Replace('\','/')
    $cargoArgs = @('--config',"source.crates-io.replace-with='vendored-sources'",'--config',("source.vendored-sources.directory='" + $vendorPath + "'"))
    Info 'Inspecting: source workspace'
    $ErrorActionPreference = 'Continue'
    $metadataJson = & "$rust\bin\cargo.exe" @cargoArgs metadata --no-deps --format-version 1 --locked --offline 2>> $log | Out-String
    $metadataExit = $LASTEXITCODE
    $ErrorActionPreference = 'Stop'
    if ($metadataExit -ne 0) { Fail 'Cargo workspace inspection failed.' }
    $metadata = $metadataJson | ConvertFrom-Json
    $binaries = @(
        foreach ($package in $metadata.packages) {
            if ($metadata.workspace_members -notcontains $package.id) { continue }
            foreach ($target in $package.targets) {
                if ($target.kind -contains 'bin' -and $package.name -ne 'xtask') {
                    [pscustomobject]@{ Package = $package.name; Name = $target.name; RequiredFeatures = @($target.'required-features' | Where-Object { $_ }) }
                }
            }
        }
    )
    $selected = @($binaries | Where-Object { $_.Name -eq 'victory' })
    if ($selected.Count -eq 0 -and $binaries.Count -eq 1) { $selected = $binaries }
    if ($selected.Count -ne 1) { Fail 'Cannot select a unique application binary from source/Cargo.toml.' }
    $application = $selected[0]
    $buildArgs = $cargoArgs + @('build','--release','--locked','--offline','--target','x86_64-pc-windows-msvc','--package',$application.Package,'--bin',$application.Name)
    if ($application.RequiredFeatures.Count -gt 0) { $buildArgs += @('--features',($application.RequiredFeatures -join ',')) }
    Info ('Building: ' + $application.Package)
    Native "$rust\bin\cargo.exe" $buildArgs
    Info ('Verifying: ' + $application.Name + ' command line')
    $exe = "$work\target\x86_64-pc-windows-msvc\release\$($application.Name).exe"
    Native $exe @('--help')
    Info 'Packaging: release'
    New-Item -ItemType Directory -Force "$root\release" | Out-Null
    Copy-Item -LiteralPath $exe -Destination "$root\release\$($application.Name).exe"
    Copy-Item -LiteralPath "$deps\licenses.md" -Destination "$root\release\licenses.md"
    [IO.File]::WriteAllText("$root\release\_start.cmd", "@echo off`r`ncd /d ""%~dp0""`r`n$($application.Name).exe run ""%~dp0game_scarlett_master.exe"" --execute`r`n", [Text.Encoding]::ASCII)
    Info "Output: $root\release\$($application.Name).exe"
    Info "Build log: $log"
    exit 0
} catch {
    if ($log) { ($_ | Out-String) | Add-Content -LiteralPath $log }
    Write-Host ('[X] ' + $_.Exception.Message)
    if ($log -and (Test-Path -LiteralPath $log)) {
        Write-Host "[X] Full log: $log"
        if (!$script:ExpectedFailure) {
            Get-Content -LiteralPath $log -Tail 100 | Where-Object { $_ -notmatch '^warning:|^\s*--> |^\s*\||^\s*[0-9]+\s*\|' } | ForEach-Object { Write-Host $_ }
        }
    }
    exit 1
}